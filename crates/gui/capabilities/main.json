{
  "identifier": "main",
  "description": "The Devid window: daemon requests, opening Devid's own sites, folders and files, and dragging the window by its toolbar. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-daemon",
    "allow-open",
    "allow-copy-url",
    "allow-copy-log-path",
    "allow-server-config",
    "allow-choose-folder",
    "allow-doctor",
    "allow-devid-check",
    "allow-in-terminal",
    "allow-login-item",
    "allow-self-update",
    "allow-relaunch",
    "allow-quit",
    "core:window:allow-start-dragging"
  ]
}
